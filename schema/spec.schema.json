{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KILN spec block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "tier",
    "category",
    "pitch",
    "features",
    "entities",
    "storage",
    "done_means",
    "not"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^app-[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "pitch": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "label",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "text",
                    "longtext",
                    "number",
                    "date",
                    "bool",
                    "select",
                    "tags"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 2
                },
                "default": {}
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "namespace"
      ],
      "properties": {
        "kind": {
          "enum": [
            "localstorage"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "done_means": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "not": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}