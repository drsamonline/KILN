{
  "version": 2,
  "note": "Kits are internal. Nothing here points at another repository. A kit is a region of templates/app/index.html plus a runtime capability, and it ships inside this repo. There is no clone step, no submodule, no vendored copy to drift.",
  "kits": {
    "web-kit": {
      "bundled": true,
      "kind": "runtime",
      "provides": [
        "shell",
        "inline manifest",
        "print stylesheet",
        "string table"
      ],
      "source": "templates/app/index.html"
    },
    "tokens-kit": {
      "bundled": true,
      "kind": "runtime",
      "provides": [
        "colour tokens",
        "spacing scale",
        "theme switch"
      ],
      "source": "templates/app/index.html"
    },
    "widgets-kit": {
      "bundled": true,
      "kind": "runtime",
      "provides": [
        "list rows",
        "chips",
        "summary strip",
        "sort control"
      ],
      "source": "templates/app/index.html"
    },
    "search-kit": {
      "bundled": true,
      "kind": "runtime",
      "provides": [
        "field scan",
        "facet filters",
        "keyboard focus"
      ],
      "source": "templates/app/index.html"
    },
    "export-kit": {
      "bundled": true,
      "kind": "runtime",
      "provides": [
        "JSON download",
        "CSV download",
        "restore"
      ],
      "source": "templates/app/index.html"
    }
  }
}