{
  "name": "KILN",
  "tagline": "Spec in. Finished app out.",
  "version": "0.9.0",
  "kind": "compiler",
  "language": "Python",
  "runtime": "python>=3.9",
  "dependencies": [],
  "network": false,
  "offline": true,
  "licence": "PolyForm-Noncommercial-1.0.0",
  "owner": "Dr Sohil Momin",
  "repository": "https://github.com/drsamonline/KILN",
  "homepage": "https://drsamonline.github.io/KILN/",
  "entry": {
    "cli": "python3 -m kiln",
    "browser": "studio.html",
    "landing": "index.html",
    "demo": "demo.html"
  },
  "generates": {
    "artifact": "single-file HTML application",
    "size_budget_kb": 60,
    "features": 14,
    "kits": 5
  },
  "verification": {
    "tests": 127,
    "guards": 136,
    "ci": ".github/workflows/kiln.yml"
  },
  "topics": [
    "offline-first",
    "single-file",
    "code-generator",
    "no-dependencies",
    "app-builder",
    "spec-driven",
    "local-first",
    "python"
  ],
  "support": {
    "upi": "drsohilboi@ybl",
    "github_sponsors": "https://github.com/sponsors/drsamonline",
    "ko_fi": "https://ko-fi.com/matneo",
    "paypal": "https://paypal.me/drsohilmomin?locale.x=en_GB&country.x=IN",
    "books": "https://www.amazon.com/stores/author/B08ZT331LY/allbooks",
    "email": "sohilmomin2000@gmail.com"
  },
  "licensing": {
    "editions": [
      "personal",
      "commercial"
    ],
    "personal": "free for personal use, PolyForm Noncommercial, sponsor and author block in the app",
    "commercial": "paid, full features, no sponsor block, one line of compiler credit",
    "demo": "the personal edition, capped, online only \u2014 not an edition",
    "key": "Ed25519, verified offline, pinned public key in catalogue/licence-key.json",
    "watermark": "build record + fingerprint + integrity check in every generated app",
    "doc": "LICENSING.md"
  },
  "output": {
    "layout": "single file",
    "file": "index.html",
    "docs_flag": "--with-docs"
